# Text that tests read byte for byte, or search for a line break, checks out
# with LF on every OS whatever core.autocrlf says (CI-01): Rust sources (the
# source-scanning tripwires include_str! them), the JSON contract snapshots and
# goldens, Markdown, CSV and text manifests, and the TOML, YAML and shell files
# tests read. The -text rules below come later and win for the files they name.
*.rs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yml text eol=lf
# Committed with CRLF and read by no test: kept byte for byte.
research/experiments/results/*.csv -text
# Committed bytes that are hashed or compiled in must be the same on every
# checkout (D-021): no end-of-line conversion.
assets/fontindex.json -text
assets/gmaps/*.gmap -text
assets/fonts/*.ttf -text
assets/licenses/OFL-Noto.txt -text
# Fetched by hash (fetch-assets.sh), some with CRLF line endings (G-10).
assets/licenses/ofl/*.txt -text
assets/dicts/*.txt -text
# The Markdown export golden is compared byte for byte (T-32b).
tests/data/export/*.md -text
# The corpus manifest is pinned by its sha256 and the smoke list is compared
# line for line (T-26): no end-of-line conversion.
bench/*.txt -text
bench/*.csv -text
