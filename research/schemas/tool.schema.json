{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tool",
 "title": "Tooling ledger entry",
 "type": "object",
 "required": [
  "id",
  "name",
  "category",
  "purpose",
  "verdict",
  "checked_at",
  "provenance"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^TOOL-\\d{3}$"
  },
  "name": {
   "type": "string"
  },
  "category": {
   "enum": [
    "discovery",
    "fulltext-access",
    "paper-parsing",
    "gap-mining",
    "reference-mgmt",
    "knowledge-base",
    "repair-engine",
    "validator",
    "renderer",
    "text-extraction",
    "metric",
    "corpus",
    "fault-injection",
    "fuzzer",
    "ml-model",
    "library-rust",
    "library-python",
    "infrastructure",
    "other"
   ]
  },
  "purpose": {
   "type": "string"
  },
  "workstreams": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "url": {
   "type": [
    "string",
    "null"
   ]
  },
  "version": {
   "type": [
    "string",
    "null"
   ]
  },
  "last_release": {
   "type": [
    "string",
    "null"
   ]
  },
  "license": {
   "type": [
    "string",
    "null"
   ]
  },
  "cost": {
   "type": [
    "string",
    "null"
   ]
  },
  "keys_required": {
   "type": [
    "string",
    "null"
   ]
  },
  "verified_in_container": {
   "enum": [
    "pass",
    "fail",
    "partial",
    "untested"
   ]
  },
  "verification_evidence": {
   "type": [
    "string",
    "null"
   ]
  },
  "verdict": {
   "enum": [
    "Adopt",
    "Trial",
    "Assess",
    "Hold"
   ]
  },
  "rationale": {
   "type": [
    "string",
    "null"
   ]
  },
  "alternatives": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "checked_at": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "provenance": {
   "type": "object",
   "required": [
    "agent",
    "method",
    "added_at"
   ],
   "properties": {
    "agent": {
     "type": "string",
     "description": "role of the agent that created the record, e.g. 'chair', 'scoping-backward'"
    },
    "method": {
     "enum": [
      "crossref",
      "dblp",
      "opencitations",
      "arxiv",
      "openalex",
      "semantic-scholar",
      "core",
      "parallel-search",
      "parallel-fetch",
      "webfetch",
      "websearch",
      "local-file",
      "memory",
      "user",
      "derived"
     ]
    },
    "search_id": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^SRCH-\\d{4}$"
    },
    "added_at": {
     "type": "string",
     "format": "date"
    }
   }
  }
 }
}