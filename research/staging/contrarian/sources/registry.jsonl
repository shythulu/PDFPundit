{"id": "SRC-1105", "type": "preprint", "title": "Valid Per-Field Selective Risk Control for Document Extraction: Three Failure Modes, a Validity Ladder, and When Conditioning Pays", "authors": ["Bhaskar Gurram"], "year": 2026, "venue": "arXiv", "doi": null, "arxiv": "2608.14639", "url": "https://arxiv.org/abs/2608.14639", "aliases": [], "duplicate_of": null, "access": "oa", "status": "read", "topics": ["evaluation-metrics", "toolpath-selection"], "relevance": 3, "evidence_grade": {"damage": "n/a", "code_public": true, "data_public": null, "replicated": null}, "summary": "Per-field accept/review with selective-risk guarantees on document extraction: fields cluster within documents (design effect about 2), field-iid certificates are invalid, and only a document-iid Learn-then-Test tier matches the data, which is near-vacuous at small document counts. Direct analogue of WP-3.13 slot certification with slots clustered in base documents.", "provenance": {"agent": "contrarian", "method": "arxiv", "search_id": "SRCH-1118", "added_at": "2026-10-05"}, "dedupe_key": "arxiv:2608.14639", "fulltext_sha256": "d230c8f6b9331b774c4db6e14ed24eecaa1b2faf91adbc3789d866dce48bf9a0", "text_sha256": "877c6728be7e67e369dc8e2eeb0ed298e5ffae4a368d43e09f5083c4ecaf0ee0", "extractor": "pdftotext", "extractor_version": "pdftotext version 24.02.0", "fulltext_from": "https://arxiv.org/pdf/2608.14639", "fulltext_fetched_at": "2026-10-05", "title_check": "pass"}
